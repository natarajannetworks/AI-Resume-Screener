# --- Security (NEVER PUSH THESE) ---
.env
*.env
app/.env
backend/.env
ai_module/.env

# --- Databases ---
*.db
resume.db
sqlite.db

# --- Python & Cache ---
__pycache__/
*.pyc
*.py[cod]
*$py.class
.pytest_cache/
ai_module/ranking_output.json

# --- Virtual Environments ---
venv/
env/
.venv/

